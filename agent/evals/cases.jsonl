{"id": "p03", "text": "apaga a luz de fora", "expect": {"tool": "lights", "args": {"zone": "outside", "power": "off"}}}
{"id": "p04", "text": "roxo cinquenta por cento", "expect": {"tool": "lights", "args": {"zone": "both", "colour": "purple", "level": 50}}}
